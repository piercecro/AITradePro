import { useEffect, useState } from "react";

interface Testimonial {
  id: number;
  name: string;
  image: string;
  text: string;
}

// Add your 9 testimonials here
const testimonials: Testimonial[] = [
  { id: 1, name: "Alice", image: "/images/testimonials/alice.jpg", text: "This platform is amazing!" },
  { id: 2, name: "Bob", image: "/images/testimonials/bob.jpg", text: "I love using this service." },
  { id: 3, name: "Charlie", image: "/images/testimonials/charlie.jpg", text: "Highly recommend!" },
  { id: 4, name: "Diana", image: "/images/testimonials/diana.jpg", text: "Fantastic experience." },
  { id: 5, name: "Eve", image: "/images/testimonials/eve.jpg", text: "Very reliable." },
  { id: 6, name: "Frank", image: "/images/testimonials/frank.jpg", text: "Great support team." },
  { id: 7, name: "Grace", image: "/images/testimonials/grace.jpg", text: "Love the interface!" },
  { id: 8, name: "Hank", image: "/images/testimonials/hank.jpg", text: "Easy to use." },
  { id: 9, name: "Ivy", image: "/images/testimonials/ivy.jpg", text: "Will use again!" },
];

export default function Testimonials() {
  const [currentIndex, setCurrentIndex] = useState(0);
  const [fade, setFade] = useState(true);

  // Automatically rotate testimonials
  useEffect(() => {
    const interval = setInterval(() => {
      setFade(false); // start fade out
      setTimeout(() => {
        setCurrentIndex((prev) => (prev + 3) % testimonials.length);
        setFade(true); // fade in new set
      }, 500); // fade duration
    }, 5000); // change every 5 seconds
    return () => clearInterval(interval);
  }, []);

  // Get current 3 testimonials
  const currentTestimonials = [
    testimonials[currentIndex],
    testimonials[(currentIndex + 1) % testimonials.length],
    testimonials[(currentIndex + 2) % testimonials.length],
  ];

  return (
    <div className={`flex justify-center gap-6 transition-opacity duration-500 ${fade ? 'opacity-100' : 'opacity-0'}`}>
      {currentTestimonials.map((t) => (
        <div
          key={t.id}
          className="flex flex-col items-center bg-[#13151f] shadow-lg rounded-xl p-6 w-64"
        >
          <img
            src={t.image}
            alt={t.name}
            className="w-16 h-16 rounded-full object-cover mb-3"
          />
          <p className="text-gray-300 italic text-sm mb-2">&quot;{t.text}&quot;</p>
          <p className="text-white font-semibold">{t.name}</p>
        </div>
      ))}
    </div>
  );
}

